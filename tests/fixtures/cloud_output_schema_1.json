{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "found": {
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "not_found",
            "auth_wall",
            "network_error"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "metaDescription": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pageText": {
      "anyOf": [
        {
          "type": "string",
          "description": "Cleaned plain text of primary landing content."
        },
        {
          "type": "null"
        }
      ]
    },
    "ogImage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "socialLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "Short lowercase platform identifier."
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "platform",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "teamSize": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "found",
    "socialLinks"
  ],
  "additionalProperties": false
}