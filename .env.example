# Copy this file to .env in OpenBrowse's home directory: ~/.openbrowse/ for a
# tool install, the repository root for a source checkout. Every value below is
# the default, so a line you do not care about can be left exactly as it is.
#
# OPENBROWSE_HOME is the one setting that cannot live here: it decides which
# .env gets read, so it has to be set in the environment before OpenBrowse
# starts. Export it from your shell or from the systemd unit instead.

# Required
ANTHROPIC_API_KEY=sk-ant-...
API_KEY=your-secret-bearer-token

# Required only if you request gpt-* models (e.g. gpt-5.6-terra)
OPENAI_API_KEY=sk-proj-...

# The model used when a request does not name one.
DEFAULT_MODEL=claude-sonnet-5

# Dashboard Basic auth. The password falls back to API_KEY when left blank.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Serve the dashboard and API with no authentication at all. Only ever set this
# to 1 on a machine nothing else can reach.
ALLOW_INSECURE_NO_AUTH=0

# Concurrent sessions this device runs. The /setup screen and the dashboard's
# Settings page recommend a value for this machine; by hand, budget roughly
# 2GB RAM and one CPU core per session.
MAX_CONCURRENT_SESSIONS=1

# Lighter Chromium profile: no GPU process, capped helper processes and
# per-tab JS heap. The /setup screen pre-selects it on small or GPU-less
# hosts; an unusually heavy web app may prefer it off.
CHROME_LIGHT_FLAGS=0

# How long a keep-alive session waits, browser and history still open, for the
# next follow-up before closing itself. Seconds; 0 waits indefinitely. A parked
# session is also closed early if a newly started session needs its display slot.
KEEP_ALIVE_IDLE_TIMEOUT=600

# Scale an incoming API maxCostUsd to local cost. Cloud budgets run roughly
# twice this device's real cost, so 0.5 makes a Cloud $6 cap land at $3 locally.
# Greater than 0 and at most 1; 1.0 leaves budgets untouched.
CLOUD_MAX_COST_FACTOR=1.0

# CAPTCHA solving through CapSolver. Without a key, CAPTCHAs are recognised and
# reported but never solved.
CAPSOLVER_API_KEY=CAP-...
# Ceiling on CAPTCHA spend for a single task. The default is about ten solves; a
# keep-alive session gets that allowance again for each follow-up. 0 removes it.
CAPTCHA_MAX_COST_USD=0.03

# How often to check PyPI for a new release, in hours. 0 turns the background
# check off, and with it the dashboard's update badge.
UPDATE_CHECK_HOURS=6
