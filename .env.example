# Required
ANTHROPIC_API_KEY=sk-ant-...
API_KEY=your-secret-bearer-token

# Optional
# Required only if you request gpt-* models (e.g. gpt-5.6-terra)
OPENAI_API_KEY=sk-proj-...
CAPSOLVER_API_KEY=CAP-...
# Dashboard Basic auth. Defaults: user "admin", password falls back to API_KEY
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Concurrent sessions this device runs (suggested: 3 small boards/VPS, 5 for Pi 5 16GB)
MAX_CONCURRENT_SESSIONS=5
