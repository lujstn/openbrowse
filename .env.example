# Required
ANTHROPIC_API_KEY=sk-ant-...
API_KEY=your-secret-bearer-token

# Optional
# Required only if you request gpt-* models (e.g. gpt-5.6-terra)
OPENAI_API_KEY=sk-proj-...
# Required only if you request gemini-* models (e.g. gemini-3.7-flash)
GEMINI_API_KEY=AIza...
CAPSOLVER_API_KEY=CAP-...
# Dashboard Basic auth. Defaults: user "admin", password falls back to API_KEY
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Concurrent sessions this device runs. Each session is a full Chromium plus a
# virtual display: budget roughly 2GB RAM and one CPU core per session
# (2 = ~4GB/2 cores, 5 = ~8-16GB/4 cores, 20 = ~40GB/16+ cores).
MAX_CONCURRENT_SESSIONS=1
