# Required
ANTHROPIC_API_KEY=sk-ant-...
API_KEY=your-secret-bearer-token

# Optional
# Required only if you request gpt-* models (e.g. gpt-5.6-terra)
OPENAI_API_KEY=sk-proj-...
CAPSOLVER_API_KEY=CAP-...
# Ceiling on CAPTCHA spend for a single task. Default 0.03, about ten solves; a
# keep-alive session gets that allowance again for each follow-up. 0 removes it
# CAPTCHA_MAX_COST_USD=0.03
# How long a keep-alive session waits, browser and history still open, for the
# next follow-up before closing itself. Seconds; 0 waits indefinitely. A parked
# session is also closed early if a newly started session needs its display slot.
KEEP_ALIVE_IDLE_TIMEOUT=600
# Dashboard Basic auth. Defaults: user "admin", password falls back to API_KEY
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Concurrent sessions this device runs. The /setup screen and the dashboard's
# Settings page recommend a value for this machine; by hand, budget roughly
# 2GB RAM and one CPU core per session.
MAX_CONCURRENT_SESSIONS=1
# Scale an incoming API maxCostUsd to local cost. Cloud budgets run roughly
# twice this device's real cost, so 0.5 makes a Cloud $6 cap land at $3 locally.
# Greater than 0 and at most 1; 1.0 (the default) leaves budgets untouched.
# CLOUD_MAX_COST_FACTOR=0.5

# Lighter Chromium for constrained hosts (Raspberry Pi): skips the GPU probe,
# caps helper processes and per-tab JS heap. Off until benchmarked on the host.
CHROME_LIGHT_FLAGS=0
